# Copy to .env.local for local development; never commit real credentials.
FUYAO_API_KEY=
# OpenAI-compatible Chat Completions endpoint. Keep every key on the server.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Optional alternative: Gemini key with https://generativelanguage.googleapis.com/v1beta/openai
# and an account-available model such as gemini-3.5-flash-lite. Verify with a real call.
# For PUBLIC sites, protect free quotas and authorized data with a separate access code.
# Visitors supply this in the settings dialog; the browser stores it in memory.
RESEARCH_ACCESS_CODE=
